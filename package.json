{
  "name": "Corivo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "node ./node_modules/react-native/cli.js run-android",
    "android:release": "node ./node_modules/react-native/cli.js run-android --variant=release",
    "ios": "node ./node_modules/react-native/cli.js run-ios",
    "ios:release": "node ./node_modules/react-native/cli.js run-ios --configuration Release",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && xcodebuild clean -workspace Corivo.xcworkspace -scheme Corivo",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "start": "node ./node_modules/react-native/cli.js start",
    "test": "node ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-camera-roll/camera-roll": "^7.4.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@shopify/react-native-skia": "^2.3.0",
    "@tanstack/react-query": "^5.17.0",
    "jotai": "^2.6.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-image-picker": "^7.1.0",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "5.1.8-1",
    "react-native-localize": "^3.6.1",
    "react-native-mmkv": "^2.11.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.16.0",
    "react-native-share": "^10.0.2",
    "react-native-svg": "^15.15.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@testing-library/react-native": "^12.4.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.14.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.1.1+sha512.ec40d0639bb307441b945d9467139cbb88d14394baac760b52eca038b330d16542d66fef61574271534ace5a200518dabf3b53a85f1f9e4bfa37141b538a9590"
