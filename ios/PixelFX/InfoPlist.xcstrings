{
  "sourceLanguage" : "en",
  "strings" : {
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج PixelFX إلى إذن لحفظ الصور المعدلة في مكتبة الصور." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX potřebuje oprávnění k ukládání upravených obrázků do vaší knihovny fotografií." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX skal have tilladelse til at gemme dine redigerede billeder i dit fotobibliotek." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX benötigt die Berechtigung, bearbeitete Bilder in deiner Fotomediathek zu sichern." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Το PixelFX χρειάζεται άδεια για να αποθηκεύει τις επεξεργασμένες εικόνες στη βιβλιοθήκη φωτογραφιών σας." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX needs permission to save your edited images to your photo library." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX necesita permiso para guardar las imágenes editadas en tu fototeca." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX tarvitsee luvan tallentaa muokatut kuvat kuvakirjastoosi." } },
        "fil" : { "stringUnit" : { "state" : "translated", "value" : "Kailangan ng PixelFX ng pahintulot na i-save ang mga na-edit mong larawan sa photo library." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX a besoin de votre autorisation pour enregistrer les images modifiées dans votre photothèque." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX זקוק להרשאה כדי לשמור את התמונות שערכת בספריית התמונות." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी एडिट की गई इमेज को फ़ोटो लाइब्रेरी में सेव करने के लिए PixelFX को अनुमति चाहिए।" } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "A Corivónak engedélyre van szüksége a szerkesztett képek fotókönyvtárba mentéséhez." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX memerlukan izin untuk menyimpan gambar yang Anda edit ke galeri foto." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX richiede l’autorizzazione per salvare le immagini modificate nella libreria foto." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "編集した画像を写真ライブラリに保存するには、PixelFXに許可が必要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX에서 편집한 이미지를 사진 보관함에 저장하려면 권한이 필요합니다." } },
        "ms" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX memerlukan kebenaran untuk menyimpan imej yang anda edit ke pustaka foto." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX trenger tillatelse til å lagre de redigerte bildene i bildebiblioteket ditt." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX heeft toestemming nodig om je bewerkte afbeeldingen in je fotobibliotheek te bewaren." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX potrzebuje uprawnienia do zapisywania edytowanych obrazów w bibliotece zdjęć." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O PixelFX precisa de permissão para salvar as imagens editadas na sua biblioteca de fotos." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX are nevoie de permisiune pentru a salva imaginile editate în biblioteca foto." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX требуется разрешение для сохранения отредактированных изображений в медиатеку." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX behöver tillåtelse för att spara dina redigerade bilder i bildbiblioteket." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX ต้องการสิทธิ์เพื่อบันทึกรูปภาพที่แก้ไขแล้วไปยังคลังรูปภาพของคุณ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX’nun düzenlediğiniz görüntüleri fotoğraf arşivinize kaydetmek için izne ihtiyacı var." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX потрібен дозвіл, щоб зберігати відредаговані зображення у вашій фототеці." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX cần quyền để lưu ảnh đã chỉnh sửa vào thư viện ảnh của bạn." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX 需要权限才能将编辑后的图像保存到您的照片图库。" } }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج PixelFX إلى الوصول إلى مكتبة الصور لتتمكن من اختيار صور لتحريرها." } },
        "cs" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX potřebuje přístup k vaší knihovně fotografií, abyste mohli vybrat obrázky k úpravě." } },
        "da" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX skal have adgang til dit fotobibliotek, så du kan vælge billeder til redigering." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX benötigt Zugriff auf deine Fotomediathek, damit du Bilder zum Bearbeiten auswählen kannst." } },
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Το PixelFX χρειάζεται πρόσβαση στη βιβλιοθήκη φωτογραφιών σας για να επιλέγετε εικόνες προς επεξεργασία." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX needs access to your photo library so you can select images for editing." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX necesita acceso a tu fototeca para que puedas seleccionar imágenes y editarlas." } },
        "fi" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX tarvitsee pääsyn kuvakirjastoosi, jotta voit valita muokattavia kuvia." } },
        "fil" : { "stringUnit" : { "state" : "translated", "value" : "Kailangan ng PixelFX ng access sa photo library para makapili ka ng mga larawang ie-edit." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX a besoin d’accéder à votre photothèque pour vous permettre de sélectionner des images à modifier." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX זקוק לגישה לספריית התמונות כדי לאפשר לך לבחור תמונות לעריכה." } },
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "एडिट करने के लिए इमेज चुनने हेतु PixelFX को आपकी फ़ोटो लाइब्रेरी का एक्सेस चाहिए।" } },
        "hu" : { "stringUnit" : { "state" : "translated", "value" : "A Corivónak hozzáférésre van szüksége a fotókönyvtárhoz, hogy képeket választhass szerkesztésre." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX memerlukan akses ke galeri foto agar Anda dapat memilih gambar untuk diedit." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX richiede l’accesso alla libreria foto per consentirti di selezionare le immagini da modificare." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "編集する画像を選択できるように、PixelFXは写真ライブラリへのアクセスを必要とします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "편집할 이미지를 선택하려면 PixelFX에 사진 보관함 접근 권한이 필요합니다." } },
        "ms" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX memerlukan akses ke pustaka foto supaya anda boleh memilih imej untuk diedit." } },
        "nb" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX trenger tilgang til bildebiblioteket ditt, slik at du kan velge bilder for redigering." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX heeft toegang tot je fotobibliotheek nodig, zodat je afbeeldingen kunt kiezen om te bewerken." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX potrzebuje dostępu do biblioteki zdjęć, aby umożliwić wybieranie obrazów do edycji." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "O PixelFX precisa acessar sua biblioteca de fotos para que você possa selecionar imagens para editar." } },
        "ro" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX are nevoie de acces la biblioteca foto pentru a putea selecta imagini de editat." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX нужен доступ к вашей медиатеке, чтобы вы могли выбирать изображения для редактирования." } },
        "sv" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX behöver åtkomst till ditt bildbibliotek så att du kan välja bilder att redigera." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX ต้องการเข้าถึงคลังรูปภาพเพื่อให้คุณเลือกรูปภาพมาแก้ไขได้" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX, düzenlemek üzere görüntü seçebilmeniz için fotoğraf arşivinize erişmek istiyor." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX потрібен доступ до вашої фототеки, щоб ви могли вибирати зображення для редагування." } },
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX cần truy cập thư viện ảnh để bạn có thể chọn ảnh cần chỉnh sửa." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "PixelFX 需要访问您的照片图库，以便您选择要编辑的图像。" } }
      }
    }
  },
  "version" : "1.0"
}
